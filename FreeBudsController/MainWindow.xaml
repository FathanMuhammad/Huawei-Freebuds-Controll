<Window x:Class="FreeBudsController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Huawei FreeBuds SE4 ANC Controller"
        Height="570" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Style for Mode Selection Buttons -->
        <Style x:Key="ModeCardButton" TargetType="Button">
            <Setter Property="Background" Value="#151D2F"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22304A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Level Radio/Buttons -->
        <Style x:Key="LevelChipButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Status Card -->
            <RowDefinition Height="Auto"/> <!-- Mode Selector -->
            <RowDefinition Height="Auto"/> <!-- Levels Selector -->
            <RowDefinition Height="*"/>    <!-- Spacer -->
            <RowDefinition Height="Auto"/> <!-- Device Settings -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" Background="#1E293B" CornerRadius="12" Margin="0,0,12,0">
                <TextBlock Text="🎧" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="FreeBuds SE4 ANC" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Huawei Audio Controller" FontSize="11" Foreground="#64748B"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="BtnRefreshStatus" Click="BtnRefreshStatus_Click"
                    Style="{StaticResource LevelChipButton}" Padding="8,6" VerticalAlignment="Center" ToolTip="Cek Status Aktual">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄 " FontSize="12"/>
                    <TextBlock Text="Refresh" FontSize="11"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- STATUS CARD -->
        <Border Grid.Row="1" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="MODE SAAT INI" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtCurrentStatus" Text="Memeriksa status..." FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock x:Name="TxtStatusDetail" Text="Terhubung ke FreeBuds" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Battery Badge (if available) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" x:Name="PanelBattery" Visibility="Collapsed">
                    <TextBlock Text="BATERAI" FontSize="9" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtBatteryInfo" Text="L: -% | R: -%" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN ANC MODES (OFF, AWARENESS, NOISE CANCELLING) -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="PILIH MODE KONTROL" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,8"/>

            <!-- Mode 1: Off -->
            <Button x:Name="BtnModeOff" Click="BtnModeOff_Click" Style="{StaticResource ModeCardButton}" Margin="0,0,0,8">
                <Grid Width="350">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔇" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Off" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Mode normal tanpa peredam kebisingan" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="IndicatorOff" Width="8" Height="8" CornerRadius="4" Background="Transparent" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- Mode 2: Awareness -->
            <Button x:Name="BtnModeAwareness" Click="BtnModeAwareness_Click" Style="{StaticResource ModeCardButton}" Margin="0,0,0,8">
                <Grid Width="350">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="👂" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Awareness" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="Transparansi suara sekitar tetap terdengar jelas" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="IndicatorAwareness" Width="8" Height="8" CornerRadius="4" Background="Transparent" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- Mode 3: Noise Cancelling -->
            <Button x:Name="BtnModeAnc" Click="BtnModeAnc_Click" Style="{StaticResource ModeCardButton}">
                <Grid Width="350">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔕" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Noise Cancelling" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="Meredam suara bising di sekitar secara aktif" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="IndicatorAnc" Width="8" Height="8" CornerRadius="4" Background="Transparent" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </StackPanel>

        <!-- NOISE CANCELLING LEVEL CHIPS -->
        <Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="INTENSITAS NOISE CANCELLING" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                <UniformGrid Columns="4">
                    <Button x:Name="BtnLvlGeneral" Click="BtnLvlGeneral_Click" Content="General" Style="{StaticResource LevelChipButton}" Margin="2,0"/>
                    <Button x:Name="BtnLvlCozy" Click="BtnLvlCozy_Click" Content="Cozy" Style="{StaticResource LevelChipButton}" Margin="2,0"/>
                    <Button x:Name="BtnLvlUltra" Click="BtnLvlUltra_Click" Content="Ultra" Style="{StaticResource LevelChipButton}" Margin="2,0"/>
                    <Button x:Name="BtnLvlDynamic" Click="BtnLvlDynamic_Click" Content="Dynamic" Style="{StaticResource LevelChipButton}" Margin="2,0"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- BOTTOM SETTINGS & MAC ADDRESS -->
        <Border Grid.Row="5" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="12,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="MAC ADDRESS BLUETOOTH" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAutoDetect" Click="BtnAutoDetect_Click" Content="Auto Detect" Style="{StaticResource LevelChipButton}" HorizontalAlignment="Right" Padding="6,2" FontSize="10"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtMacAddress" Grid.Column="0"
                             Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155"
                             FontFamily="Consolas, Courier New" FontSize="12" Padding="8,5"
                             VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSaveMac" Grid.Column="1" Click="BtnSaveMac_Click"
                            Content="Simpan" Style="{StaticResource LevelChipButton}" Padding="12,5" Foreground="#F8FAFC"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
